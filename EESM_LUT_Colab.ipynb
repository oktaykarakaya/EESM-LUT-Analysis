def _roc_auc_binary(y, score):
    y = np.asarray(y, dtype=bool)
    x = np.asarray(score, dtype=float)
    ok = np.isfinite(x)
    y, x = (y[ok], x[ok])
    pos = int(y.sum())
    neg = len(y) - pos
    if pos == 0 or neg == 0:
        return float('nan')
    r = rankdata(x, method='average')
    return float((r[y].sum() - pos * (pos + 1) / 2) / (pos * neg))
