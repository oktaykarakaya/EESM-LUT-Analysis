        bs = int(base_seed + 10000 * r)
        rec = two_way_seed_cluster_bootstrap(seed_level_df, value_col, seed_col=seed_col, cluster_cols=cluster_cols, B=B, seed=bs)
        rec['rng_repeat'] = int(r + 1)
        rows.append(rec)
    return pd.DataFrame(rows)
