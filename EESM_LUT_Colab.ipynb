def one_step_mse(model):
    model.eval()
    with torch.no_grad():
        pred = model(torch.tensor(Xt, device=DEVICE)).cpu().numpy()
    return float(np.mean((pred - Yt) ** 2))

def train_family(name, certified, params, seeds, selection='rollout'):
